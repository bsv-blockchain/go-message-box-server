# ================================================================================================
# 🏗️ PROJECT CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for go-message-box-server
# Load Order: 90 (loaded after all defaults, overrides earlier files)
#
# This file contains project-specific configuration that overrides the defaults
# from earlier env files. Use this for settings unique to this repository.
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

# Custom Go Version per go.mod
GO_PRIMARY_VERSION=1.27.x
GO_SECONDARY_VERSION=1.27.x
MAGE_X_GO_SECONDARY_VERSION=1.27.x
MAGE_X_GO_VERSION=1.27.x

# ================================================================================================
# 📊 COVERAGE CONFIGURATION
# ================================================================================================

# Coverage Provider Selection (override from internal to codecov)
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration
CODECOV_TOKEN_REQUIRED=true

# Coverage Exclusions (matches codecov.yml ignore paths)
GO_COVERAGE_EXCLUDE_PATHS=test/,vendor/,testdata/,examples/,example/,plans/,docs/,.github/,.mage-cache/,.vscode/,bin/,mocks/,testing/

# Skip URL Checks in Coverage Reports
GO_COVERAGE_SKIP_URL_CHECKS=true

# ================================================================================================
# 🏗️ BUILD TAG CONFIGURATION
# ================================================================================================

# Exclude GOOS names from auto-discovered build tags to prevent conflicts in Go 1.26+.
# Using GOOS names (e.g. "windows") as custom build tags causes internal/goos redeclarations
# when running on a different OS (e.g. macOS with -tags windows).
MAGE_X_AUTO_DISCOVER_BUILD_TAGS_EXCLUDE=race,custom,windows

# ================================================================================================
# 🛡️ SECURITY EXCLUSIONS
# ================================================================================================

# CVE-2023-26248 / GO-2024-3218 (libp2p/go-libp2p-kad-dht DHT content censorship) is
# transitive via go-wallet-toolbox's services and has no upstream fix (Fixed in: N/A).
# The server never joins or serves an IPFS DHT; excluded as in go-wallet-toolbox and arcade.

# GHSA-hp3w-g68c-fv3c (sprintf-js DoS via unbounded precision specifiers) affects every
# published sprintf-js release (<= 1.1.3) and has no patched version. It is a dev-only
# transitive of the Jest test client (test-client/: jest -> babel-plugin-istanbul ->
# @istanbuljs/load-nyc-config -> js-yaml@3 -> argparse@1), never shipped in the server
# binary or image. js-yaml loads argparse only from its CLI (bin/js-yaml.js), which the
# test client never runs, so the vulnerable code is unreachable.

# GHSA-8r5x-fm3f-whwj, GHSA-p8wg-vrv2-v86f, GHSA-xw65-4hp5-5hc7 (handlebars <= 4.7.9 JavaScript
# injection via crafted templates) are dev-only transitives of the Jest test client
# (test-client/: ts-jest -> handlebars@4.7.9), never shipped in the server binary or image.
# ts-jest loads handlebars only from its `ts-jest config:init` CLI (dist/cli/config/init.js),
# which compiles a hard-coded template and is never run by the test client, so no untrusted
# template reaches Handlebars.compile. Fixed in handlebars 4.7.10 (2026-10-05); drop these
# three once test-client/package-lock.json resolves handlebars >= 4.7.10.
SECURITY_VULN_EXCLUDES=GHSA-hp3w-g68c-fv3c,GHSA-8r5x-fm3f-whwj,GHSA-p8wg-vrv2-v86f,GHSA-xw65-4hp5-5hc7

# Nancy CVE Exclusions (known acceptable vulnerabilities)
NANCY_EXCLUDES=CVE-2023-26248,CVE-2026-5160,GO-2026-5932

# Govulncheck/Magex CVE Exclusions (known acceptable vulnerabilities)
MAGE_X_CVE_EXCLUDES=CVE-2023-26248,CVE-2026-5160,GO-2026-5932

# ================================================================================================
# 🏗️ BUILD OPTIMIZATION
# ================================================================================================

# Skip pre-building packages during cache warming to prevent OOM kills.
# Even batch_size=3 with GOGC=50 exceeds the ~7GB available on standard runners
# because heavy packages (cmd/certifier, cmd/infra) pull in the entire dependency
# tree (libp2p, k8s, googleapis, etc.).
# The module cache (go mod download) is still warmed — that provides the biggest
# speedup. Build artifacts get cached naturally after the first real build job.
MAGE_X_BUILD_STRATEGY=skip
